# ============================================================
# akanesia-router — .gitignore
# Repo ini PRIVATE: hanya cache & artefak build yang di-ignore.
# Semua source, docs, dan file .env ikut ter-commit.
# PERINGATAN: jika repo ini dijadikan publik, hapus .env dari
# git (git rm --cached .env) dan rotasi semua secret di dalamnya.
# ============================================================

# --- Cache: dependencies ---
/node_modules/
/.pnp
.pnp.*
.yarn/*

# --- Cache: build outputs ---
/.next/
/.next-cli-build/
/out/
/build/
/coverage
/.vercel
cli/.build-home/
graphify-out/*

# --- Cache: backup refactor (jangan di-bundle/lint) ---
open-sse.old/

# --- OS / editor junk ---
.DS_Store
.idea/
.cursor/*

# --- Debug logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
debug.log
.dev-server.log
.dev-server-err.log

# --- Runtime logs (dibuat ulang saat server jalan) ---
logs/

# --- Working dir lokal mesin ini (notes, skills, dsb) ---
.claude/
.docs/
.repo/
.script/
.codegraph/
.PR/
.next-analyze/*
.kiro/
9router-*

# --- File sensitif / temporary lokal ---
*.pem
.engine-token.txt
.tmp-prov.json
.tmp-providers.json
.oauth-session.json
.start-dev.ps1
start-dev-silent.cjs
